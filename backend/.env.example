# PHANTOM X Environment Configuration
# Core Application
APP_ENV=development
API_PORT=8000
API_HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Threat Intelligence Providers (Optional - leave empty for graceful fallback / reported as UNAVAILABLE)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# AI Attack Story Generator (Optional - fallback template used if empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Safety and Sandbox Controls
ALLOW_ACTIVE_REDIRECT_FETCHING=true
REDIRECT_TIMEOUT_SECONDS=4
MAX_REDIRECT_HOPS=5
MAX_RESPONSE_BYTES=1048576

# Database
DATABASE_URL=sqlite:///./phantom_x.db
